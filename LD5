%% Privaloma uzduotis 2
clear all
clc

while true
    disp('Naujas skaičiavimų ciklas');
    m = input('Iveskite m reikšme: ');
    n = input('Iveskite n reikšme: ');

    if m == n
        disp('Ivestos vienodos reikšmės. Programa baigia darba.');
        break;
    end

    while m > 0 && n > 0
        if m > n
            m = m - n;
        else
            n = n - m;
        end
    end

    if m > 0
        rezultatas = m;
    else
        rezultatas = n;
    end

    disp(['Maziausia teigiama reiksme: ', num2str(rezultatas)]);
    disp(' '); 
end

%% Papildoma uzduotis
clear all
clc

sakinys = input('Iveskite sakini (su keliais tarpais tarp zodziu): ', 's');
sakinys = strtrim(sakinys);

while contains(sakinys, '  ')
    sakinys = strrep(sakinys, '  ', ' ');
end

disp('Sutvarkytas sakinys: ');
disp(sakinys);

zodziu_skaicius = 0;

if ~isempty(sakinys)
    zodziu_skaicius = 1; 

    for i = 1:length(sakinys)
        if sakinys(i) == ' '
            zodziu_skaicius = zodziu_skaicius + 1;
        end
    end
end

disp(['Ivestu zodziu skaicius: ', num2str(zodziu_skaicius)]);
