clear all
clc
% Privaloma uzduotis 1a
x_rand = (2 * rand(1, 200) -1) .* sqrt(pi / 2);
y_rand = (2 * rand(1, 200) -1) .* sqrt(pi / 2);

x = sort(x_rand);
y = sort(y_rand);

[X, Y] = meshgrid(x, y);

Z = sin(X.^2 + Y.^2);

figure(1);
surf(X, Y, Z);
view(15, 15);
colormap('winter');            
shading interp; 


title('Tridatis paviršius: f(x,y) = sin(x^2 + y^2)');
xlabel('X ašis');
ylabel('Y ašis');
zlabel('Z reikšmės');
grid on;



%% Privaloma uzduotis 1b
clear all
clc

x = linspace(-1, 1, 100);
y = linspace(-1, 1, 100);

[X, Y] = meshgrid(x, y);

R = sqrt(X.^2 + Y.^2);
Z = exp(R.^2);

figure(2);
surf(X, Y, Z);

colormap('parula');  
shading flat;  

view(20, 20);

title('Trimatis paviršius: z(r) = e^{r^2}');
xlabel('X ašis');
ylabel('Y ašis');
zlabel('Z reikšmės');
grid on;


%% Papildoma uzduotis
clear all
clc

x = linspace(-2, 2, 50);
y = linspace(-2, 2, 50);
[X, Y] = meshgrid(x, y);

Z = 1 - (X.^2 + Y.^2);

figure('Name', '14 variantas: Funkcijos surf savybės', 'NumberTitle', 'off');

% A variantas
subplot(1, 3, 1);
surf(X, Y, Z);
shading interp;            
camlight left; 
lighting gouraud; 
title('a) Su apšvietimu (camlight)');
xlabel('X'); ylabel('Y'); zlabel('Z');
grid on;

% B variantas
subplot(1, 3, 2);
meshc(X, Y, Z);    
title('b) Su kontūru pagrinde');
xlabel('X'); ylabel('Y'); zlabel('Z');
grid on;

% C variantas

subplot(1, 3, 3);
surf(X, Y, Z); 
title('c) Paprastas paviršius');
xlabel('X'); ylabel('Y'); zlabel('Z');
grid on;

colormap('winter');
